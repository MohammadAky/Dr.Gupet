NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL="mysql://pet:pet@localhost:3306/pet_db"
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_DEV_CODE=12345
# Dedicated secret for hashing OTP codes (required in production; keeps OTP
# hashing independent from JWT secrets so rotations never orphan in-flight codes)
OTP_HASH_SECRET=

SMS_DRIVER=console
SMS_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_PARAM_NAME=Code
SMS_IR_BASE_URL=https://api.sms.ir/v1
SMS_IR_LINE_NUMBER=
# Notification policy — set to false to silence payment-success texts
SMS_NOTIFY_PAYMENT_SUCCESS=true

# mock is development/test only; disabled permits production before gateway licensing.
# disabled rejects checkout and payment mutations on the server.
PAYMENT_DRIVER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Optional endpoint overrides (tests / future gateway changes)
ZARINPAL_API_BASE=
ZARINPAL_STARTPAY_BASE=
PAYMENT_CALLBACK_URL=http://localhost:3000/api/v1/payments/callback
FRONTEND_PAYMENT_RESULT_URL=http://localhost:5173/payment/result
# Mock gateway landing page (dev/test only)
PAYMENT_MOCK_PAY_URL=http://localhost:3000/api/v1/payments/mock-pay
# Secret for HMAC-signing payment callback URLs (falls back to JWT_ACCESS_SECRET)
PAYMENT_CALLBACK_SECRET=
# Number of proxy hops in front of the API (for correct client IPs in logs/throttling). Empty = direct.
TRUST_PROXY=
# Per-user daily upload quota
UPLOAD_DAILY_COUNT_LIMIT=50
UPLOAD_DAILY_BYTES_LIMIT=52428800

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

SHIPPING_FLAT_COST=50000
FREE_SHIPPING_THRESHOLD=1500000
ORDER_EXPIRE_MINUTES=30

ADMIN_SEED_PHONE=09120000000
