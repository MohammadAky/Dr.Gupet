// =====================================================================
// Pet System - MVP schema (SQLite)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// کاربر و آدرس
// ---------------------------------------------------------------------

model User {
  id              Int      @id @default(autoincrement())
  firstName       String?
  lastName        String?
  phone           String   @unique
  isPhoneVerified Boolean  @default(false)
  avatar          String?
  role            String   @default("USER")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  addresses         Address[]
  pets              Pet[]
  cart              Cart?
  favorites         Favorite[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  receiverName  String
  receiverPhone String
  province      String
  city          String
  fullAddress   String
  postalCode    String?
  lat           Float?
  lng           Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------
// پت
// ---------------------------------------------------------------------

model PetType {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  breeds     Breed[]
  pets       Pet[]
  categories ProductCategory[]
  products   Product[]
  medicines  Medicine[]
}

model Breed {
  id        Int     @id @default(autoincrement())
  petTypeId Int
  name      String
  isActive  Boolean @default(true)

  petType PetType @relation(fields: [petTypeId], references: [id])
  pets    Pet[]

  @@unique([petTypeId, name])
}

model Pet {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  petTypeId  Int
  breedId    Int?
  birthDate  DateTime?
  gender     String?
  isNeutered Boolean  @default(false)
  weightKg   Float?
  photo      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  petType PetType @relation(fields: [petTypeId], references: [id])
  breed   Breed?  @relation(fields: [breedId], references: [id])
  tags    PetTag[]
}

model PetTag {
  petId Int
  tagId Int

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([petId, tagId])
}

// ---------------------------------------------------------------------
// کاتالوگ محصول
// ---------------------------------------------------------------------

model Tag {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique
  type String

  petTags     PetTag[]
  productTags ProductTag[]
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  logo        String?
  country     String?
  description String?
  isActive    Boolean @default(true)

  products Product[]
}

model ProductCategory {
  id        Int     @id @default(autoincrement())
  name      String
  slug      String  @unique
  petTypeId Int?
  parentId  Int?
  image     String?
  isActive  Boolean @default(true)

  petType  PetType?          @relation(fields: [petTypeId], references: [id])
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  brandId           Int
  categoryId        Int
  petTypeId         Int
  lifeStage         String   @default("ALL")
  sizeClass         String   @default("ALL")
  neuterSuitability String   @default("ANY")
  ingredientsText   String?
  description       String?
  isActive          Boolean  @default(true)
  minPrice          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brand    Brand           @relation(fields: [brandId], references: [id])
  category ProductCategory @relation(fields: [categoryId], references: [id])
  petType  PetType         @relation(fields: [petTypeId], references: [id])

  variants  ProductVariant[]
  images    ProductImage[]
  tags      ProductTag[]
  favorites Favorite[]
}

model ProductVariant {
  id             Int     @id @default(autoincrement())
  productId      Int
  sku            String  @unique
  weightGram     Int
  price          Int
  compareAtPrice Int?
  stock          Int     @default(0)
  isActive       Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductTag {
  productId Int
  tagId     Int
  kind      String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId, kind])
}

model Favorite {
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// ---------------------------------------------------------------------
// سبد خرید، کوپن، سفارش، پرداخت
// ---------------------------------------------------------------------

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  type           String
  value          Int
  minOrderAmount Int?
  maxDiscount    Int?
  startAt        DateTime?
  endAt          DateTime?
  totalLimit     Int?
  perUserLimit   Int?
  isActive       Boolean  @default(true)

  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        Int      @id @default(autoincrement())
  couponId  Int
  userId    Int
  orderId   Int      @unique
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
}

model Order {
  id              Int      @id @default(autoincrement())
  orderNumber     String   @unique
  userId          Int
  addressSnapshot String
  itemsTotal      Int
  discountAmount  Int      @default(0)
  shippingCost    Int      @default(0)
  finalAmount     Int
  couponId        Int?
  status          String   @default("PENDING_PAYMENT")
  shippingMethod  String?
  trackingCode    String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  coupon     Coupon?           @relation(fields: [couponId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  redemption CouponRedemption?
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  variantId   Int
  productName String
  weightGram  Int
  unitPrice   Int
  quantity    Int
  total       Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id         Int      @id @default(autoincrement())
  orderId    Int
  amount     Int
  gateway    String
  gatewayRef String?
  status     String   @default("INITIATED")
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

// ---------------------------------------------------------------------
// دارو و داروخانه
// ---------------------------------------------------------------------

model Medicine {
  id                   Int     @id @default(autoincrement())
  name                 String
  activeIngredient     String?
  type                 String?
  brand                String?
  usage                String?
  notes                String?
  requiresPrescription Boolean @default(false)
  image                String?
  isActive             Boolean @default(true)

  pharmacies PharmacyMedicine[]
  petTypes   MedicinePetType[]
}

model Pharmacy {
  id           Int     @id @default(autoincrement())
  name         String
  province     String
  city         String
  address      String
  lat          Float?
  lng          Float?
  phone        String?
  workingHours String?
  is24h        Boolean @default(false)
  isVerified   Boolean @default(false)
  isActive     Boolean @default(true)

  medicines PharmacyMedicine[]
}

model PharmacyMedicine {
  pharmacyId      Int
  medicineId      Int
  note            String?
  lastConfirmedAt DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, medicineId])
}

// Explicit many-to-many for Medicine <-> PetType (SQLite doesn't support implicit)
model MedicinePetType {
  medicineId Int
  petTypeId  Int

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  petType  PetType  @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([medicineId, petTypeId])
}