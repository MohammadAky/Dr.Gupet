// =====================================================================
// Pet System - MVP schema (PostgreSQL)
// نکته: تمام مبالغ Int هستند و به صورت تومان (یا ریال) ذخیره می‌شوند؛
// واحد را از اول ثابت نگه دارید.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum LifeStage {
  PUPPY_KITTEN
  ADULT
  SENIOR
  ALL
}

enum SizeClass {
  SMALL
  MEDIUM
  LARGE
  ALL
}

enum NeuterSuitability {
  ANY
  NEUTERED_ONLY
}

enum TagType {
  ALLERGEN // مرغ، گاو، ماهی، گلوتن، ...
  DIET // بدون غلات، کنترل وزن، مراقبت ادراری، ...
}

enum ProductTagKind {
  CONTAINS // محصول این آلرژن را دارد
  SUITABLE_FOR // محصول برای این رژیم/نیاز مناسب است
}

enum CouponType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------
// کاربر و آدرس
// ---------------------------------------------------------------------

model User {
  id              Int        @id @default(autoincrement())
  firstName       String?
  lastName        String?
  phone           String     @unique
  isPhoneVerified Boolean    @default(false)
  avatar          String?
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  addresses         Address[]
  pets              Pet[]
  cart              Cart?
  favorites         Favorite[]
  orders            Order[]
  couponRedemptions CouponRedemption[]

  @@map("users")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  receiverName  String
  receiverPhone String
  province      String
  city          String
  fullAddress   String
  postalCode    String?
  lat           Float?
  lng           Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------
// پت
// ---------------------------------------------------------------------

model PetType {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)

  breeds     Breed[]
  pets       Pet[]
  categories ProductCategory[]
  products   Product[]
  medicines  Medicine[]

  @@map("pet_types")
}

model Breed {
  id       Int     @id @default(autoincrement())
  petTypeId Int
  name     String
  isActive Boolean @default(true)

  petType PetType @relation(fields: [petTypeId], references: [id])
  pets    Pet[]

  @@unique([petTypeId, name])
  @@map("breeds")
}

model Pet {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String
  petTypeId  Int
  breedId    Int? // nullable: نژاد نامشخص یا آمیخته
  birthDate  DateTime? // تاریخ تولد (تقریبی هم قابل قبول است)
  gender     Gender?
  isNeutered Boolean   @default(false)
  weightKg   Decimal?  @db.Decimal(5, 2)
  photo      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  petType PetType @relation(fields: [petTypeId], references: [id])
  breed   Breed?  @relation(fields: [breedId], references: [id])
  tags    PetTag[]

  @@index([userId])
  @@map("pets")
}

// حساسیت‌ها و نیازهای رژیمی پت (Tag با type = ALLERGEN | DIET)
model PetTag {
  petId Int
  tagId Int

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([petId, tagId])
  @@map("pet_tags")
}

// ---------------------------------------------------------------------
// کاتالوگ محصول
// ---------------------------------------------------------------------

model Tag {
  id   Int     @id @default(autoincrement())
  name String
  slug String  @unique
  type TagType

  petTags     PetTag[]
  productTags ProductTag[]

  @@index([type])
  @@map("tags")
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  logo        String?
  country     String?
  description String?
  isActive    Boolean @default(true)

  products Product[]

  @@map("brands")
}

model ProductCategory {
  id        Int     @id @default(autoincrement())
  name      String
  slug      String  @unique
  petTypeId Int?
  parentId  Int?
  image     String?
  isActive  Boolean @default(true)

  petType  PetType?          @relation(fields: [petTypeId], references: [id])
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

model Product {
  id                Int               @id @default(autoincrement())
  name              String
  slug              String            @unique
  brandId           Int
  categoryId        Int
  petTypeId         Int
  lifeStage         LifeStage         @default(ALL)
  sizeClass         SizeClass         @default(ALL)
  neuterSuitability NeuterSuitability @default(ANY)
  ingredientsText   String?
  description       String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  brand    Brand           @relation(fields: [brandId], references: [id])
  category ProductCategory @relation(fields: [categoryId], references: [id])
  petType  PetType         @relation(fields: [petTypeId], references: [id])

  variants  ProductVariant[]
  images    ProductImage[]
  tags      ProductTag[]
  favorites Favorite[]

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([petTypeId, lifeStage])
  @@map("products")
}

// هر وزن (۱ کیلو، ۲ کیلو، ۱۰ کیلو، ...) یک Variant است
model ProductVariant {
  id             Int     @id @default(autoincrement())
  productId      Int
  sku            String  @unique
  weightGram     Int
  price          Int
  compareAtPrice Int? // قیمت قبل از تخفیف
  stock          Int     @default(0)
  isActive       Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductTag {
  productId Int
  tagId     Int
  kind      ProductTagKind

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId, kind])
  @@index([tagId])
  @@map("product_tags")
}

model Favorite {
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

// ---------------------------------------------------------------------
// سبد خرید، کوپن، سفارش، پرداخت
// ---------------------------------------------------------------------

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// قیمت و جمع کل ذخیره نمی‌شود؛ همیشه از ProductVariant محاسبه می‌شود
model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique
  type           CouponType
  value          Int
  minOrderAmount Int?
  maxDiscount    Int?
  startAt        DateTime?
  endAt          DateTime?
  totalLimit     Int?
  perUserLimit   Int?
  isActive       Boolean    @default(true)

  orders      Order[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        Int      @id @default(autoincrement())
  couponId  Int
  userId    Int
  orderId   Int      @unique
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  userId          Int
  addressSnapshot Json // کپی آدرس در لحظه ثبت سفارش
  itemsTotal      Int
  discountAmount  Int         @default(0)
  shippingCost    Int         @default(0)
  finalAmount     Int
  couponId        Int?
  status          OrderStatus @default(PENDING_PAYMENT)
  shippingMethod  String?
  trackingCode    String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  coupon     Coupon?           @relation(fields: [couponId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  redemption CouponRedemption?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

// snapshot از محصول در لحظه خرید
model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  variantId   Int
  productName String
  weightGram  Int
  unitPrice   Int
  quantity    Int
  total       Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int
  amount     Int
  gateway    String
  gatewayRef String?
  status     PaymentStatus @default(INITIATED)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([gatewayRef])
  @@map("payments")
}

// ---------------------------------------------------------------------
// دارو و داروخانه (فقط معرفی؛ بدون قیمت و موجودی)
// ---------------------------------------------------------------------

model Medicine {
  id                   Int     @id @default(autoincrement())
  name                 String
  activeIngredient     String?
  type                 String? // قرص، شربت، پماد، ...
  brand                String?
  usage                String? // کاربرد (بدون دوز؛ دوز را دامپزشک تعیین می‌کند)
  notes                String?
  requiresPrescription Boolean @default(false)
  image                String?
  isActive             Boolean @default(true)

  petTypes   PetType[] // many-to-many ضمنی
  pharmacies PharmacyMedicine[]

  @@index([name])
  @@map("medicines")
}

model Pharmacy {
  id           Int     @id @default(autoincrement())
  name         String
  province     String
  city         String
  address      String
  lat          Float?
  lng          Float?
  phone        String?
  workingHours String?
  is24h        Boolean @default(false)
  isVerified   Boolean @default(false)
  isActive     Boolean @default(true)

  medicines PharmacyMedicine[]

  @@index([city])
  @@map("pharmacies")
}

model PharmacyMedicine {
  pharmacyId      Int
  medicineId      Int
  note            String?
  lastConfirmedAt DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, medicineId])
  @@index([medicineId])
  @@map("pharmacy_medicines")
}
